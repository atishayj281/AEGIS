# =============================================================================

# -----------------------------------------------------------------------------
# Python (FastAPI / Backend)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Ruff / linters
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# API keys, credentials, JWT secrets
secrets.json
secrets.yaml
secrets.toml
credentials.json
service_account.json

# -----------------------------------------------------------------------------
# Node / React (Frontend)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
out/

# Vite
.vite/

# Next.js (if migrated)
.next/

# Cache
.eslintcache
.stylelintcache
*.tsbuildinfo

# Coverage
coverage/
lcov.info

# Parcel
.parcel-cache/

# Storybook
storybook-static/

# -----------------------------------------------------------------------------
# Database & Vector Store
# -----------------------------------------------------------------------------
# SQLite (used by the Enterprise RAG backend)
*.db
*.sqlite
*.sqlite3
enterprise.db

# ChromaDB local persistence
chroma/
chroma_db/
.chroma/
chromadb_data/

# FAISS index files
*.faiss
*.index
faiss_index/

# Weaviate / Pinecone local exports
weaviate_data/
pinecone_cache/

# Generic vector store dumps
vector_store/
embeddings_cache/

# -----------------------------------------------------------------------------
# Data & Uploads (sample datasets are committed; real enterprise data is not)
# -----------------------------------------------------------------------------
# Uploaded files at runtime
uploads/
user_uploads/
tmp_uploads/

# Large data exports
*.csv.gz
*.jsonl.gz
*.parquet

# Model weights / embeddings (too large for git)
models/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx

# Keep the sample data folder but ignore real data dropped in
data/live/
data/production/
data/private/

# -----------------------------------------------------------------------------
# Logs & Audit
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
audit_export/
audit_*.json

# -----------------------------------------------------------------------------
# OS & Editor
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
*~ 
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace

# -----------------------------------------------------------------------------
# Docker & Infrastructure
# -----------------------------------------------------------------------------
.dockerignore
docker-compose.override.yml

# Terraform state (if infra is added)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# HTTP client scratch files (Insomnia, Postman exports with real tokens)
*.rest
insomnia_export*.json
postman_export*.json

# Temporary files
*.tmp
*.temp
*.bak
*.orig
.temp/
tmp/

