# Optional: enable LLM-backed response generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application
APP_NAME=Enterprise RAG Intelligence Platform
DEBUG=true
DATA_DIR=./data

NVIDIA_API_KEY=
QDRANT_API_KEY=

# Auth0 — the frontend handles login and obtains RS256 access tokens.
# The backend only verifies tokens against the JWKS endpoint; it never issues them.
# Set these to match your Auth0 tenant and API audience.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# --- Phase 4: Pinecone vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aegis-documents

# --- Phase 4: Object storage (task 4.5) ---
# Set OBJECT_STORAGE_BACKEND=s3 for production; leave as "local" for dev/CI.
# For local MinIO, set AWS_ENDPOINT_URL to your MinIO instance URL.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./data/object_store
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Phase 5: Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Admin user provisioning: Auth0 Management API (infoDba M2M app) ---
# Create a Machine-to-Machine application in Auth0 named "infoDba".
# Authorize it against the Auth0 Management API with ONLY these scopes:
#   create:users, update:users, delete:users, create:organization_members
# Rotate immediately if either value is ever exposed. Never commit real values.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Phase 6: Compliance & Audit ---
# Max query requests per user per minute (rate limiting on /api/v1/query).
# Set to 0 to disable rate limiting (not recommended in production).
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Phase 7: Platform superuser (aegis_platform_admin, BYPASSRLS) ---
# Same host/port/database as DATABASE_URL, different role + password.
# The password is set once, manually, out of version control:
#   ALTER ROLE aegis_platform_admin WITH PASSWORD '<strong-secret>';
# Run scripts/bootstrap_platform_admin.py once after setting this URL to
# insert the first platform_admins row.
# Leave blank in dev/test unless you are specifically testing the bypass path.
PLATFORM_ADMIN_DATABASE_URL=postgresql+asyncpg://aegis_platform_admin:<password>@localhost:5432/aegis
PLATFORM_ADMIN_AUTH0_SUB=auth0|<platform-operator-user-id>
PLATFORM_ADMIN_EMAIL=platform-admin@yourcompany.com