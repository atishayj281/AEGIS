# Optional: enable LLM-backed response generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT settings
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Application
APP_NAME=Enterprise RAG Intelligence Platform
DEBUG=true
DATA_DIR=./data

NVIDIA_API_KEY=
QDRANT_API_KEY=

# Auth0 and Multi-tenancy Migration settings
AUTH_PROVIDER=legacy
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_CLIENT_ID=your-auth0-client-id
INTERNAL_SECRET=your-internal-api-secret-key
