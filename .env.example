# Optional: enable LLM-backed response generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application
APP_NAME=Enterprise RAG Intelligence Platform
DEBUG=true
DATA_DIR=./data

NVIDIA_API_KEY=
QDRANT_API_KEY=

# Auth0 — the frontend handles login and obtains RS256 access tokens.
# The backend only verifies tokens against the JWKS endpoint; it never issues them.
# Set these to match your Auth0 tenant and API audience.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# --- Phase 4: Pinecone vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aegis-documents

# --- Phase 4: Object storage (task 4.5) ---
# Set OBJECT_STORAGE_BACKEND=s3 for production; leave as "local" for dev/CI.
# For local MinIO, set AWS_ENDPOINT_URL to your MinIO instance URL.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./data/object_store
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=